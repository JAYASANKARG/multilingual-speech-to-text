# Postgres (docker compose up -d db). Production: Neon, postgresql+asyncpg://...?ssl=require
DATABASE_URL=postgresql+asyncpg://stt:stt@localhost:5432/stt
TEST_DATABASE_URL=postgresql+asyncpg://stt:stt@localhost:5432/stt_test

# Gemini API key from Google AI Studio. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-transcribe-live

# Random string used to hash visitor IPs (rate limiting). Any long random value.
SESSION_SALT=change-me

# development | production (production: no CORS, Secure cookies, trusts X-Forwarded-For)
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# Session policy (defaults shown)
MAX_SESSION_SECONDS=300
SILENCE_TIMEOUT_SECONDS=15
SESSIONS_PER_HOUR=10
MAX_CONCURRENT_SESSIONS=3

# Directory with the built frontend (set in the Docker image)
STATIC_DIR=
